# Copy this file to .env and fill in the key for whichever provider you use.
# API keys are read from here only -- they are never stored in the database
# and never returned by the API.

# --- Provider keys (set the one(s) you have) --------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# --- Which provider to use --------------------------------------------------
# anthropic | openai | gemini | grok | deepseek
# Also switchable at runtime on the /system page; this is just the default.
LIFELOG_PROVIDER=anthropic

# Model id for that provider. Leave blank for the provider's own default
# (claude-opus-5, gpt-4o, gemini-2.0-flash, grok-2-latest, deepseek-chat).
LIFELOG_MODEL=

# --- Custom endpoint (optional) ---------------------------------------------
# Point the selected provider at a different base URL: a gateway, reseller,
# proxy, or a local server speaking the same protocol. Leave blank to use the
# provider's own API.
#
# Whoever operates that endpoint can see everything you capture, which for
# this app includes account emails, spending, and personal documents. Only
# use one you're willing to trust with that.
#
#   LIFELOG_BASE_URL=https://gw.apito.ai      # Anthropic-compatible gateway
#   LIFELOG_BASE_URL=http://localhost:11434/v1  # local OpenAI-compatible server
LIFELOG_BASE_URL=

# --- Local speech-to-text ---------------------------------------------------
# Whisper model size for voice transcription: tiny, base, small, medium, large-v3
# Runs offline on your machine; not affected by the provider setting.
LIFELOG_WHISPER_MODEL=base
