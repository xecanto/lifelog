# Copy this file to .env and fill in your key.
ANTHROPIC_API_KEY=

# Model used for organizing entries and answering questions.
# Defaults to Claude Opus 5. Swap to claude-sonnet-5 or claude-haiku-4-5
# for lower cost if you're processing a high volume of entries.
LIFELOG_MODEL=claude-opus-5

# Whisper model size for voice transcription: tiny, base, small, medium, large-v3
LIFELOG_WHISPER_MODEL=base
